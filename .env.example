# Populate these after you run `vercel env pull .env.local` once your
# Vercel Postgres (Neon) database is attached to the project, OR paste
# them in manually from the Vercel dashboard -> Storage -> your DB -> .env.local tab.
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# A random secret string. Vercel Cron sends this back as a Bearer token
# so /api/cron/refresh can confirm the request really came from Vercel
# and not a random visitor. Generate one with: openssl rand -hex 32
CRON_SECRET=""
