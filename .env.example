# Populate these after you run `vercel env pull .env.local` once your
# Vercel Postgres (Neon) database is attached to the project, OR paste
# them in manually from the Vercel dashboard -> Storage -> your DB -> .env.local tab.
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# A random secret string. Vercel Cron sends this back as a Bearer token
# so /api/cron/refresh (and /api/cron/refresh-companies) can confirm the
# request really came from Vercel and not a random visitor.
# Generate one with: openssl rand -hex 32
CRON_SECRET=""

# SEC EDGAR asks every automated requester to identify themselves with a
# real contact — set this to your own email. The company-tracking refresh
# still works without it (falls back to a generic placeholder), but SEC's
# fair-access policy asks for a real one. https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_CONTACT_EMAIL=""
