generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// One row per indication being tracked (Atopic Dermatitis, Hidradenitis
// Suppurativa, plus anything the user adds from the UI).
model Indication {
  id         String   @id @default(cuid())
  name       String   @unique
  searchTerm String // term sent to CT.gov as query.cond
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// One row per tracked compound (the 22 seed compounds, extensible from the UI).
model Compound {
  id        String   @id @default(cuid())
  name      String   @unique
  aliases   String[] @default([]) // e.g. ["AVTX-009"] for "Abdakibart"
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// One row per NCT study we've ever seen, kept in sync with clinicaltrials.gov.
model Trial {
  nctId               String   @id
  briefTitle           String
  officialTitle        String?
  overallStatus        String
  studyType             String?
  phases                String[] @default([])
  enrollmentCount       Int?
  enrollmentType        String?
  startDate             String?
  primaryCompletionDate String?
  completionDate        String?
  lastUpdatePosted      String?
  sponsorName           String?
  conditions            String[] @default([])
  interventions         Json? // [{type,name,otherNames}]
  locationsSummary      String? // e.g. "US, Germany, Japan (12 sites)"
  briefSummary          String?
  raw                   Json // full parsed snapshot, for the detail panel

  matchedIndications String[] @default([]) // Indication.name values this trial matched
  matchedCompounds   String[] @default([]) // Compound.name values this trial matched

  firstSeenAt   DateTime @default(now())
  lastCheckedAt DateTime @default(now())
  lastChangedAt DateTime? // last time any tracked field actually changed
  isNewSinceLastRefresh Boolean @default(false) // true only until the next refresh run completes
  changedInLastRefresh  Boolean @default(false) // true only until the next refresh run completes

  changes ChangeEvent[]

  @@index([lastChangedAt])
  @@index([overallStatus])
}

model ChangeEvent {
  id         String   @id @default(cuid())
  nctId      String
  trial      Trial    @relation(fields: [nctId], references: [nctId], onDelete: Cascade)
  field      String // e.g. "overallStatus", "primaryCompletionDate", "enrollmentCount"
  oldValue   String?
  newValue   String?
  detectedAt DateTime @default(now())

  @@index([nctId])
  @@index([detectedAt])
}

// Bookkeeping for the refresh cron / manual refresh button.
model RefreshLog {
  id            String   @id @default(cuid())
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  status        String   @default("running") // running | success | error
  trialsScanned Int      @default(0)
  changesFound  Int      @default(0)
  newTrials     Int      @default(0)
  errorMessage  String?
}

// One row per tracked pharma company (the 24 seed companies, extensible
// from the UI). Not every company is a public/SEC filer — Boehringer
// Ingelheim is privately held (ticker and cik both null); Bayer, Merck
// KGaA, Roche and UCB trade only as OTC ADRs abroad and don't file with
// the SEC (ticker set for stock lookups, cik null so SEC ingestion is
// skipped for them).
model Company {
  id               String   @id @default(cuid())
  name             String   @unique
  ticker           String? // stock ticker for the Yahoo quote lookup; null if not publicly traded
  cik              String? // 10-digit zero-padded SEC CIK; null if not an SEC EDGAR filer
  fdaSponsorNames  String[] @default([]) // name variant(s) openFDA's sponsor/manufacturer fields use
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())

  updates CompanyUpdate[]

  @@index([ticker])
}

// One row per discovered item for a tracked company: an SEC filing, an FDA
// approval/label event, or a press-release proxy (derived from an 8-K's
// Item 2.02/8.01). Unlike Trial, these are immutable published documents —
// there's no "changed in place" concept, so each new item is simply a new
// row, deduped by (companyId, kind, externalId) against the source's own
// stable identifier (SEC accession number, FDA application/set id, etc.).
model CompanyUpdate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String // "sec_filing" | "fda_approval" | "fda_label" | "press_release"
  externalId  String // dedupe key from the source system
  title       String
  summary     String?
  url         String?
  sourceDate  DateTime // the filing/event's own date (e.g. SEC filingDate)
  firstSeenAt DateTime @default(now()) // when this dashboard first recorded it
  raw         Json? // full parsed snapshot, for the detail panel

  @@unique([companyId, kind, externalId])
  @@index([companyId])
  @@index([sourceDate])
  @@index([firstSeenAt])
}

// Bookkeeping for the company-ingestion cron / manual refresh button.
model CompanyRefreshLog {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  status           String    @default("running") // running | success | error
  companiesScanned Int       @default(0)
  updatesFound     Int       @default(0)
  errorMessage     String?
}
